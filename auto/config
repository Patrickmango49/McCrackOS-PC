#!/bin/sh
set -eu

# Debian 13 (Trixie), 64-bit PC live image.
# This first milestone is a VM-testable live image, not yet an installer release.
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-image iso-hybrid \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-chroot-security "http://security.debian.org/debian-security/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --mirror-binary-security "http://security.debian.org/debian-security/" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --apt-recommends true \
  --debian-installer none \
  --iso-application "McCrack-COS" \
  --iso-volume "MCCRACK_COS" \
  --iso-publisher "McCrack Project" \
  --iso-preparer "McCrack-COS live-build" \
  --bootappend-live "boot=live components hostname=mccrack-cos username=mccrack locales=en_US.UTF-8 keyboard-layouts=us"
